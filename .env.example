# --- BOT Chain networks (values verified live, see docs/RESEARCH.md) ---
BOT_MAINNET_RPC_URL=https://rpc.botchain.ai
BOT_TESTNET_RPC_URL=https://rpc.bohr.life

# --- Keys (never commit real values) ---
# Deploys contracts and owns nothing at runtime.
DEPLOYER_PRIVATE_KEY=
# The applicant: the human/treasury that issues Letters and locks funds.
APPLICANT_PRIVATE_KEY=
# The agent's bound wallet (ERC-8004 agentWallet). Holds no funds; only acts.
AGENT_PRIVATE_KEY=
# The independent examiner that answers ERC-8004 validation requests.
VALIDATOR_PRIVATE_KEY=

# Blockscout on BOT Chain needs no API key; left here for other explorers.
ETHERSCAN_API_KEY=
